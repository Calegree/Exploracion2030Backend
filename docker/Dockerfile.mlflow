FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libpq-dev \
 && pip install --no-cache-dir mlflow boto3 psycopg2-binary \
 && apt-get remove -y gcc \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Copy wait script into image and ensure it's executable
COPY docker/wait-for-mlflow-db.sh /usr/local/bin/wait-for-mlflow-db.sh
RUN chmod +x /usr/local/bin/wait-for-mlflow-db.sh

ENV MLFLOW_PORT=5001

CMD ["/usr/local/bin/wait-for-mlflow-db.sh"]