FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema primero (necesarias para compilar ruedas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libopenblas-dev \
    libsndfile1 \
    gfortran \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Usar el requirements optimizado para la imagen Docker
COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

# Copiar script de espera ANTES de copiar todo el proyecto
COPY docker/wait-for-postgres.sh /usr/local/bin/wait-for-postgres.sh
RUN sed -i 's/\r$//' /usr/local/bin/wait-for-postgres.sh && chmod +x /usr/local/bin/wait-for-postgres.sh

COPY . /app

ENV PYTHONUNBUFFERED=1

# Exponer puerto para que sea accesible desde el host/emulador
EXPOSE 5000

# Variables configurables para gunicorn (se pueden sobrescribir con docker run -e)
ENV GUNICORN_BIND=0.0.0.0:5000
ENV GUNICORN_WORKERS=2
ENV GUNICORN_TIMEOUT=1200

ENTRYPOINT ["/usr/local/bin/wait-for-postgres.sh"]
CMD ["gunicorn", "src.app:app", "--bind", "0.0.0.0:5000", "--workers", "3", "--timeout", "120"]
